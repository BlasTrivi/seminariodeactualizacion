# Configuración del sistema (se carga con python-dotenv desde connection.py)

# API de cotizaciones del dólar (Ejercicio 07)
API_URL=https://dolarapi.com/v1/dolares
# Cotizaciones de otras monedas (euro, real, etc.) publicadas por la misma API
API_URL_COTIZACIONES=https://dolarapi.com/v1/cotizaciones

# Motor de base de datos (URL de SQLAlchemy). Por defecto SQLite local en la
# raíz del proyecto. Para PostgreSQL / Supabase reemplazar por:
# DATABASE_URL=postgresql+psycopg2://usuario:clave@host:5432/postgres
DATABASE_URL=sqlite:///book_manager.db

# Sitio del competidor para el scraping de precios (Sprint 3)
CUSPIDE_URL=https://cuspide.com
